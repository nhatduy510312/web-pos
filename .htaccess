RewriteEngine On
Options -Indexes
DirectoryIndex home.php index.php

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .php .css .js .json .xml .txt

<FilesMatch "^(config\.php|auto_close_shift\.php|composer\.(json|lock)|.*\.sql)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

# Public cafe website. Keep index.php as the existing authenticated POS entry.
<IfModule mod_headers.c>
    <FilesMatch "^(?!(?:home|en|gioi-thieu|thuc-don|ghe-uong-gi|den-ghe|chuyen-o-ghe|bai-viet|ghe-image|sitemap|robots)\.php$).*\.php$">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>
<FilesMatch "^README-PUBLIC-WEBSITE\.md$">
    Require all denied
</FilesMatch>
RewriteRule ^(?:site|tools)(?:/|$) - [F,L]

# Ép HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Chặn truy cập trực tiếp bằng IP
RewriteCond %{HTTP_HOST} ^\d+\.\d+\.\d+\.\d+$ [NC]
RewriteRule ^ - [F,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
